{
  "name": "markdown-read-aloud",
  "displayName": "Markdown Read Aloud — Free Neural Text-to-Speech",
  "description": "Read Markdown files aloud with free, high-quality neural voices — no API key, no sign-up. Text-to-speech (TTS) with automatic language detection across 75 languages, live 0.5×–2.5× speed, read from cursor/selection/heading, and sentence highlighting. Great for proofreading and listening to docs and READMEs.",
  "version": "1.1.1",
  "publisher": "RobinReiche",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Robin-Reiche/markdown-read-aloud"
  },
  "bugs": {
    "url": "https://github.com/Robin-Reiche/markdown-read-aloud/issues"
  },
  "homepage": "https://github.com/Robin-Reiche/markdown-read-aloud#readme",
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "keywords": [
    "markdown",
    "read aloud",
    "text to speech",
    "tts",
    "neural voices",
    "accessibility",
    "voice",
    "narrator",
    "listen to documentation",
    "proofread",
    "speech",
    "edge tts",
    "language detection",
    "multilingual",
    "markdown reader",
    "readme",
    "screen reader",
    "dyslexia",
    "audio",
    "speech synthesis",
    "natural voice",
    "a11y",
    "pronunciation",
    "listen",
    "markdown to speech",
    "read markdown",
    "text-to-speech",
    "speak",
    "aloud",
    "document reader"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0B1413",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdownReadAloud.readDocument",
        "title": "%cmd.readDocument.title%",
        "icon": "$(unmute)"
      },
      {
        "command": "markdownReadAloud.readFromCursor",
        "title": "%cmd.readFromCursor.title%"
      },
      {
        "command": "markdownReadAloud.readSelection",
        "title": "%cmd.readSelection.title%"
      },
      {
        "command": "markdownReadAloud.togglePlayPause",
        "title": "%cmd.togglePlayPause.title%"
      },
      {
        "command": "markdownReadAloud.stop",
        "title": "%cmd.stop.title%"
      },
      {
        "command": "markdownReadAloud.openPlayer",
        "title": "%cmd.openPlayer.title%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownReadAloud.readDocument",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "markdownReadAloud.readFromCursor",
          "when": "editorLangId == markdown && !editorHasSelection",
          "group": "navigation@9"
        },
        {
          "command": "markdownReadAloud.readSelection",
          "when": "editorLangId == markdown && editorHasSelection",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownReadAloud.readDocument",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "markdownReadAloud.readFromCursor",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownReadAloud.readSelection",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdownReadAloud.readFromCursor",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorLangId == markdown && editorTextFocus"
      },
      {
        "command": "markdownReadAloud.togglePlayPause",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "markdownReadAloud.engine": {
          "type": "string",
          "enum": [
            "edge",
            "supertonic",
            "browser"
          ],
          "enumDescriptions": [
            "%config.engine.enum.edge%",
            "%config.engine.enum.supertonic%",
            "%config.engine.enum.browser%"
          ],
          "default": "edge",
          "markdownDescription": "%config.engine.description%"
        },
        "markdownReadAloud.preferredGender": {
          "type": "string",
          "enum": [
            "female",
            "male"
          ],
          "default": "female",
          "description": "%config.preferredGender.description%"
        },
        "markdownReadAloud.speed": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 2.5,
          "description": "%config.speed.description%"
        },
        "markdownReadAloud.volume": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 1,
          "description": "%config.volume.description%"
        },
        "markdownReadAloud.autoDetectLanguage": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoDetectLanguage.description%"
        },
        "markdownReadAloud.perParagraphLanguage": {
          "type": "boolean",
          "default": false,
          "description": "%config.perParagraphLanguage.description%"
        },
        "markdownReadAloud.fallbackLanguage": {
          "type": "string",
          "default": "en-US",
          "description": "%config.fallbackLanguage.description%"
        },
        "markdownReadAloud.voiceOverrides": {
          "type": "object",
          "default": {},
          "markdownDescription": "%config.voiceOverrides.description%",
          "additionalProperties": {
            "type": "string"
          }
        },
        "markdownReadAloud.announceHeadings": {
          "type": "boolean",
          "default": false,
          "description": "%config.announceHeadings.description%"
        },
        "markdownReadAloud.codeBlocks": {
          "type": "string",
          "enum": [
            "skip",
            "announce",
            "read"
          ],
          "enumDescriptions": [
            "%config.codeBlocks.enum.skip%",
            "%config.codeBlocks.enum.announce%",
            "%config.codeBlocks.enum.read%"
          ],
          "default": "announce",
          "description": "%config.codeBlocks.description%"
        },
        "markdownReadAloud.tables": {
          "type": "string",
          "enum": [
            "skip",
            "read"
          ],
          "default": "skip",
          "description": "%config.tables.description%"
        },
        "markdownReadAloud.highlightWhileReading": {
          "type": "boolean",
          "default": true,
          "description": "%config.highlightWhileReading.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build && node scripts/copy-flags.mjs",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies",
    "l10n": "vscode-l10n-dev export -o ./l10n ./src"
  },
  "dependencies": {
    "eld": "^2.0.3",
    "msedge-tts": "^2.0.5",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.4",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.0",
    "flag-icons": "^7.5.0",
    "pngjs": "^7.0.0",
    "svgo": "^4.0.1",
    "typescript": "^5.5.0"
  }
}
